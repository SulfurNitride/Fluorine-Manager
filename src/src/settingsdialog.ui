           <item>
            <widget class="QWidget" name="advancedCompatibilityContent">
             <layout class="QVBoxLayout" name="advancedCompatibilityContentLayout">
              <item>
               <widget class="QGroupBox" name="groupBox_65">
                <layout class="QVBoxLayout" name="verticalLayout_39">
                 <item>
                  <layout class="QFormLayout" name="vfsBackendLayout">
                   <item row="0" column="0">
                    <widget class="QLabel" name="vfsBackendLabel">
                     <property name="text">
                      <string>Backend:</string>
                     </property>
                    </widget>
                   </item>
                   <item row="0" column="1">
                    <widget class="QComboBox" name="vfsBackendComboBox">
                     <property name="toolTip">
                      <string>Select the virtual filesystem used by Windows executables in this library setup. Native Linux executables continue to use FUSE. USVFS is experimental and requires the bundled Wine-side helper.</string>
                     </property>
                    </widget>
                   </item>
                  </layout>
                 </item>
                 <item>
                  <widget class="QLabel" name="vfsBackendDescriptionLabel">
                   <property name="wordWrap">
                    <bool>true</bool>
                   </property>
                   <property name="text">
                    <string>Applies to Windows programs in this library setup. Native Linux programs keep their current behavior.</string>
                   </property>
                  </widget>
                 </item>
                </layout>
                <property name="title">
                 <string>Mod filesystem</string>
                </property>
               </widget>
              </item>
              <item>
               <widget class="QGroupBox" name="groupBox_64">
                <layout class="QVBoxLayout" name="verticalLayout_38">
                 <item>
                  <layout class="QHBoxLayout" name="horizontalLayout_14">
                   <item>
                    <widget class="QLabel" name="label_65">
                     <property name="text">
                      <string>Wrapper Command:</string>
                     </property>
                    </widget>
                   </item>
                   <item>
                    <widget class="QLineEdit" name="launchWrapperEdit"/>
                   </item>
                  </layout>
                 </item>
                </layout>
                <property name="title">
                 <string>Launch wrapper</string>
                </property>
                <property name="toolTip">
                 <string>This launch wrapper applies across all library setups.</string>
                </property>
               </widget>
              </item>
              <item>
               <widget class="QWidget" name="experimentalFilesystemGroup">
                <layout class="QVBoxLayout" name="experimentalFilesystemGroupLayout">
                 <item>
                  <widget class="QLabel" name="experimentalFilesystemNote">
                   <property name="wordWrap">
                    <bool>true</bool>
                   </property>
                   <property name="text">
                    <string>Experimental options for this library setup</string>
                   </property>
                  </widget>
                 </item>
                 <item>
                  <widget class="QCheckBox" name="usvfsExactQueryExhaustionCheckBox">
                   <property name="text">
                    <string>Skip exhausted exact directory queries (experimental)</string>
                   </property>
                   <property name="toolTip">
                    <string>Removes a redundant backing-directory continuation query after an exact virtual match. Disabled by default after a visual asset regression; enable only for one-at-a-time comparison testing.</string>
                   </property>
                  </widget>
                 </item>
                 <item>
                  <widget class="QCheckBox" name="usvfsSharedContextCheckBox">
                   <property name="text">
                    <string>Use recursive shared context locking (experimental)</string>
                   </property>
                   <property name="toolTip">
                    <string>Allows concurrent read-labelled USVFS operations after the audited write paths are separated. Disabled by default; synthetic concurrency improves, but Skyrim startup was neutral.</string>
                   </property>
                  </widget>
                 </item>
                 <item>
                  <widget class="QCheckBox" name="fuseAllowOtherCheckBox">
                   <property name="text">
                    <string>Allow other users to access FUSE mounts (allow_other)</string>
                   </property>
                   <property name="toolTip">
                    <string>Allow other users, including root, to access this library setup's FUSE mounts, subject to file permissions. Applies to the next mount. If needed, enabling this option offers to configure /etc/fuse.conf using administrator authentication. Disabled by default. Does not affect USVFS launches.</string>
                   </property>
                  </widget>
                 </item>
                 <item>
                  <widget class="QCheckBox" name="fuseCaseInsensitiveHintCheckBox">
                   <property name="text">
                    <string>Tell Wine the mod filesystem is case-insensitive (faster)</string>
                   </property>
                   <property name="toolTip">
                    <string>Wine scans a whole directory in userspace every time a file name is not found with exact case. The mod filesystem already matches names case-insensitively, so that scan can never find anything. With this on, the filesystem says so and Wine skips the scan, which makes missing-file probes several times faster in large directories. Applies to the next mount. Turn it off only to test whether a file lookup problem comes from this. Does not affect USVFS launches.</string>
                   </property>
                  </widget>
                 </item>
                 <item>
                  <widget class="QCheckBox" name="fuseIoUringCheckBox">
                   <property name="text">
                    <string>Use io_uring for the mod filesystem (experimental)</string>
                   </property>
                   <property name="toolTip">
                    <string>Carries FUSE requests over io_uring instead of /dev/fuse. Measured gains are mostly for many small files read in parallel; large sequential reads can be slightly slower. Requires the kernel parameter fuse.enable_uring=Y (kernel 6.14 or newer); enabling this option offers to set it using administrator authentication, and the setting lasts until reboot unless made permanent. Without it, the normal transport is used. Applies to the next mount. Does not affect USVFS launches.</string>
                   </property>
                  </widget>
                 </item>
                 <item>
                  <widget class="QLabel" name="cacheScopeNote">
                   <property name="wordWrap">
                    <bool>true</bool>
                   </property>
                   <property name="text">
                    <string>Troubleshooting · All library setups</string>
                   </property>
                  </widget>
                 </item>
                 <item>
                  <widget class="QCheckBox" name="disableVfsCacheCheckBox">
                   <property name="text">
                    <string>Disable VFS cache (diagnostic)</string>
                   </property>
                   <property name="toolTip">
                    <string>Zeroes the mod filesystem's kernel-facing cache timeouts instead of caching aggressively. Use this to test whether a "stale file" or "won't save" report is actually a VFS caching bug before chasing one — it is not meant to stay on, and will noticeably slow down modded games with large modlists.</string>
                   </property>
                  </widget>
                 </item>
                </layout>
               </widget>
              </item>
             </layout>
            </widget>
           </item>
